# Allegro REST API
# Zarejestruj aplikację w panelu Allegro i ustaw redirect URI na:
# https://twoj-projekt.vercel.app/api/allegro/callback
ALLEGRO_CLIENT_ID=
ALLEGRO_CLIENT_SECRET=
ALLEGRO_REDIRECT_URI=http://localhost:3000/api/allegro/callback
ALLEGRO_ENV=sandbox

# Docelowo: osobny Supabase dla danych sklepu i bezpiecznego magazynu integracji.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
