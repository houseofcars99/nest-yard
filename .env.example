# Allegro REST API
# Zarejestruj aplikację w panelu Allegro i ustaw redirect URI na:
# https://twoj-projekt.vercel.app/api/allegro/callback
ALLEGRO_CLIENT_ID=
ALLEGRO_CLIENT_SECRET=
ALLEGRO_REDIRECT_URI=http://localhost:3000/api/allegro/callback
ALLEGRO_ENV=sandbox

# TOLLA / Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# Czech bulk fulfilment admin endpoint
FULFILMENT_ADMIN_TOKEN=

# Automated customer email delivery via Resend
RESEND_API_KEY=
VIGNETTE_FROM_EMAIL=
